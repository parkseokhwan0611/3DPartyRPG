  npcId: NPC_Jack
  npcType: 2
  dialogueLines:
  - speaker: 0
    customSpeakerName: 
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4 \uC6A9\uC0AC\uB2D8\uB4E4 \uB355\uBD84\uC5D0
      \uC0B4\uC558\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    customSpeakerName: 
    text: "\uC774 \uACF3\uC5D0\uB294 \uACE0\uBE14\uB9B0 \uC5F0\uAE08\uC220\uC0AC\uAC00
      \uB3C5\uC744 \uB358\uC838\uB300\uC11C \uC9C0\uB098\uAC08 \uC218\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    customSpeakerName: 
    text: "\uACE0\uBE14\uB9B0 \uC5F0\uAE08\uC220\uC0AC\uB97C \uCC98\uCE58\uD574\uC8FC\uC138\uC694."
  - speaker: 2
    customSpeakerName: 
    text: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uB7F0\uB370 \uB9C8\uBB3C\uC774
      \uB9D0\uC744 \uD558\uB294\uAC78 \uBCF8\uC801 \uC788\uB098\uC694?"
  - speaker: 0
    customSpeakerName: 
    text: "\uB9D0\uD558\uB294 \uB9C8\uBB3C\uC740 \uBCF8 \uC801 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    customSpeakerName: 
    text: "\uD639\uC2DC \uB9D0\uD558\uB294 \uB9C8\uBB3C\uC744 \uBCF4\uC168\uB098\uC694?"
  - speaker: 2
    customSpeakerName: 
    text: "\uC544\uB2C8\uC5D0\uC694 \uADF8\uC800 \uAD81\uAE08\uD574\uC11C \uBB3C\uC5B4\uBD24\uC5B4\uC694."
  - speaker: 3
    customSpeakerName: 
    text: "\uC5B4\uC11C \uC548\uC804\uD55C \uACF3\uC73C\uB85C \uD53C\uC2E0\uD558\uC138\uC694."
  - speaker: 0
    customSpeakerName: 
    text: "\uB124 \uAC10\uC0AC\uD569\uB2C8\uB2E4."
  notReadyDialogueLines:
  - speaker: 0
    customSpeakerName: 
