--- !u!114 &8583794404380174458
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4272975157967784468}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 23a6d0d6f97a13b40895c95e19a1e392, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\uC138\uACC4\uC218\uC758 \uC218\uD638\uC790"
  npcId: NPC_TreeGuardian
  npcType: 2
  dialogueLines:
  - speaker: 0
    text: "\uC601\uC6C5\uB4E4\uC774\uC5EC \uC800\uC758 \uBD80\uB984\uC5D0 \uC751\uD574\uC8FC\uC154\uC11C
      \uAC10\uC0AC\uD569\uB2C8\uB2E4."
  - speaker: 1
    text: "\uACE0\uACB0\uD55C \uB300\uC9C0\uC758 \uD608\uC871\uC778 \uB0B4\uAC00
      \uC65C \uC774 \uC794\uBC14\uB9AC\uB4E4\uACFC \uC788\uB294\uC9C0 \uBAA8\uB974\uACA0\uAD70."
  - speaker: 2
    text: "\uC800\uC57C\uB9D0\uB85C \uC800 \uC57C\uB9CC\uC778\uACFC \uC65C \uC788\uB294\uC9C0
      \uBAA8\uB974\uACA0\uB124\uC694."
  - speaker: 3
    text: "\uB450 \uBD84 \uB2E4 \uBB34\uB840\uD558\uAD70\uC694. \uADF8\uB9CC \uC2F8\uC6B0\uC2DC\uACE0
      \uC6B0\uC120 \uD560 \uC77C\uC744 \uD558\uC8E0."
  - speaker: 0
    text: "\uC911\uC7AC \uAC10\uC0AC\uD569\uB2C8\uB2E4 \uB2EC\uC758 \uC5EC\uC2E0\uB2D8."
  - speaker: 0
    text: "\uC544\uC2DC\uB2E4\uC2DC\uD53C \uC138\uACC4\uC218\uB294 \uBCD1\uB4E4\uC5C8\uACE0
      \uBCD1\uB4E0 \uC138\uACC4\uC218\uC758 \uC78E\uC740 \uC0B4\uC544\uC788\uB294
      \uC0DD\uBB3C\uC744 \uB9C8\uBB3C\uB85C \uB9CC\uB4E4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC138 \uBD84\uC740 \uB9C8\uBB3C\uB4E4\uC744 \uBB3C\uB9AC\uCE58\uACE0
      \uC138\uACC4\uC218\uC758 \uC78E\uC744 \uBAA8\uC544\uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC78E\uC740 \uAC01 \uC9C0\uC5ED\uC758 \uC6B0\uB450\uBA38\uB9AC \uB9C8\uBB3C\uB4E4\uC774
      \uAC16\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - speaker: 1
    text: "\uC54C\uACA0\uB2E4. \uB0B4\uAC00 \uC804\uC5F4\uC744 \uB9E1\uC9C0."
  - speaker: 2
    text: "\uC804 \uB9C8\uBC95\uC73C\uB85C \uD6C4\uC5F4\uC5D0\uC11C \uD654\uB825\uC744
      \uB2F4\uB2F9\uD558\uC8E0."
  - speaker: 3
    text: "\uC804 \uCE58\uC720 \uB9C8\uBC95\uC744 \uB2F4\uB2F9\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC138 \uBD84\uAED8 \uC774 \uC138\uACC4\uC758 \uBBF8\uB798\uAC00 \uB2EC\uB824\uC788\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC6B0\uC120 \uB4A4\uC758 \uC0AC\uC81C\uB4E4\uC5D0\uAC8C \uC804\uD22C\uC758
      \uAE30\uBCF8\uC744 \uC775\uD788\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4."
  shopData: {fileID: 0}
  interactRange: 2
  promptObject: {fileID: 6520608250729514856}
