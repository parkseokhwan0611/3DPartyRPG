--- !u!114 &1782821382
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1782821378}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 23a6d0d6f97a13b40895c95e19a1e392, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\uACBD\uD5D8\uC758 \uC0AC\uC81C"
  npcId: NPC_TutorialStat
  npcType: 2
  dialogueLines:
  - speaker: 0
    text: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C \uC800\uB294 \uACBD\uD5D8\uC758 \uC0AC\uC81C\uC785\uB2C8\uB2E4.
      \uC2A4\uD0EF\uC758 \uAE30\uBCF8\uC744 \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uD018\uC2A4\uD2B8\uB97C \uD074\uB9AC\uC5B4\uD558\uAC70\uB098 \uB9C8\uBB3C\uC744
      \uCC98\uCE58\uD558\uBA74 \uACBD\uD5D8\uCE58\uAC00 \uC624\uB974\uACE0 \uACBD\uD5D8\uCE58\uAC00
      \uB2E4 \uCC28\uBA74 \uB808\uBCA8\uC774 \uC624\uB985\uB2C8\uB2E4."
  - speaker: 0
    text: "\uB808\uBCA8\uC774 \uC62C\uB77C\uB3C4 \uAE30\uBCF8 \uB2A5\uB825\uCE58\uB294
      \uC99D\uAC00\uD558\uC9C0 \uC54A\uC9C0\uB9CC, \uBAA8\uB4E0 \uD30C\uD2F0\uC6D0\uC740
      \uAC01\uAC01 5\uAC1C\uC758 \uC2A4\uD0EF \uD3EC\uC778\uD2B8\uB97C \uD68D\uB4DD\uD569\uB2C8\uB2E4."
  - speaker: 0
    text: "\uD798\uC740 \uBB3C\uB9AC \uACF5\uACA9\uB825\uC744 \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uCCB4\uB825\uC740 \uCD5C\uB300 \uCCB4\uB825\uACFC \uBC29\uC5B4\uB825\uC744
      \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC9C0\uB2A5\uC740 \uB9C8\uBC95 \uACF5\uB825\uB825\uC744 \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC2E0\uC559\uC740 \uB9C8\uBC95 \uACF5\uACA9\uB825\uACFC \uD68C\uBCF5\uB7C9\uC744
      \uC99D\uAC00\uC2DC\uD0B5\uB2C8\uB2E4."
  notReadyDialogueLines: []
  shopData: {fileID: 0}
  interactRange: 2
  promptObject: {fileID: 590915499}
