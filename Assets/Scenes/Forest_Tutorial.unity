--- !u!114 &1139505879
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1139505875}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 23a6d0d6f97a13b40895c95e19a1e392, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\uB2A5\uB825\uC758 \uC0AC\uC81C"
  npcId: NPC_TutorialSkill
  npcType: 2
  dialogueLines:
  - speaker: 0
    text: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C \uC800\uB294 \uB2A5\uB825\uC758 \uC0AC\uC81C\uC785\uB2C8\uB2E4.
      \uC2A4\uD0AC\uC758 \uAE30\uBCF8\uC744 \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uCEE8\uD2B8\uB864 \uC911\uC778 \uB9AC\uB354 \uCE90\uB9AD\uD130\uB294
      \uD50C\uB808\uC774\uC5B4\uAC00 \uC9C1\uC811 \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD574\uC57C
      \uD569\uB2C8\uB2E4."
  - speaker: 0
    text: "\uB098\uBA38\uC9C0 \uD30C\uD2F0\uC6D0\uC740 \uC2A4\uD0AC \uCFE8\uD0C0\uC784\uC774
      \uB3CC\uBA74 \uC790\uB3D9\uC73C\uB85C \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
  - speaker: 0
    text: "T\uD0A4\uB97C \uB20C\uB7EC \uB098\uBA38\uC9C0 \uD30C\uD2F0\uC6D0\uC774
      \uC790\uB3D9\uC73C\uB85C \uC2A4\uD0AC\uC744 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uAC8C
      \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uB808\uBCA8\uC774 \uC624\uB974\uBA74 \uAC01\uAC01\uC758 \uD30C\uD2F0\uC6D0\uC740
      \uC2A4\uD0AC \uD3EC\uC778\uD2B8\uB97C 1 \uD68D\uB4DD\uD569\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC2A4\uD0AC\uB9C8\uB2E4 \uC2B5\uB4DD\uC5D0 \uD544\uC694\uD55C \uC2A4\uD0AC\uD3EC\uC778\uD2B8,
      \uC2A4\uD0EF \uBC30\uC728 \uB4F1\uC774 \uB2E4\uB985\uB2C8\uB2E4."
  - speaker: 0
    text: "\uBA54\uC778, \uC11C\uBE0C \uC2A4\uD0AC\uC744 \uCD1D 4\uAC1C\uAE4C\uC9C0
      \uD035\uC2AC\uB86F\uC5D0 \uB4F1\uB85D\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - speaker: 0
    text: "\uD035\uC2AC\uB86F\uC5D0 \uB4F1\uB85D\uB41C \uC2A4\uD0AC\uB9CC \uC0AC\uC6A9
      \uAC00\uB2A5\uD558\uACE0, \uB9AC\uB354\uAC00 \uC544\uB2CC \uD30C\uD2F0\uC6D0\uB4E4\uC740
      \uD035\uC2AC\uB86F\uC5D0 \uB4F1\uB85D\uB41C \uC2A4\uD0AC\uC744 \uC790\uB3D9\uC73C\uB85C
      \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
  notReadyDialogueLines: []
  shopData: {fileID: 0}
  interactRange: 2
  promptObject: {fileID: 165123421}
