--- !u!114 &681784515
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 681784511}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 23a6d0d6f97a13b40895c95e19a1e392, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\uC138\uACC4\uC218\uC758 \uC218\uD638\uC790"
  npcId: NPC_TreeGuardian2
  npcType: 2
  dialogueLines:
  - speaker: 0
    customSpeakerName: 
    text: "\uACE0\uC0DD\uD558\uC168\uC2B5\uB2C8\uB2E4 \uC601\uC6C5\uB2D8\uB4E4."
  - speaker: 1
    customSpeakerName: 
    text: "\uC78E\uC0AC\uADC0\uB294 \uC8FC\uBA74 \uB418\uB098?"
  - speaker: 0
    customSpeakerName: 
    text: "\uC544\uB2D9\uB2C8\uB2E4 \uD55C \uBC88\uC5D0 \uC8FC\uC2DC\uBA74 \uAC10\uC0AC\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: 2
    customSpeakerName: 
    text: "\uADF8\uB098\uC800\uB098 \uB9D0\uD558\uB294 \uB9C8\uBB3C \uBCF8 \uC801 \uC788\uC5B4?"
  - speaker: 0
    customSpeakerName: 
    text: "\uB9D0\uD558\uB294 \uB9C8\uBB3C\uC774\uC694?"
  - speaker: 0
    customSpeakerName: 
    text: "\uC544\uB2C8\uC694 \uC800\uB294 \uBCF8 \uC801 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    customSpeakerName: 
    text: "\uD639\uC2DC \uB9D0\uD558\uB294 \uB9C8\uBB3C\uC744 \uBCF4\uC168\uC2B5\uB2C8\uAE4C?"
  - speaker: 3
    customSpeakerName: 
    text: "\uB124 \uC8FC\uC220\uC0AC\uAC00 \uC8FD\uAE30 \uC9C1\uC804\uC5D0 \uB9D0\uC744
      \uAC78\uB354\uB77C\uACE0\uC694."
  - speaker: 3
    customSpeakerName: 
    text: "\uC2E0\uC744 \uBBFF\uC9C0..."
  - speaker: 1
    customSpeakerName: 
    text: "(\uC27F.)"
  - speaker: 1
    customSpeakerName: 
    text: "\uB9C8\uBB3C\uC774 \uC778\uAC04\uC758 \uB9D0\uC744 \uD574\uC11C \uC2E0\uAE30\uD558\uB354\uAD70."
  - speaker: 0
    customSpeakerName: 
    text: "\uBB50\uB77C\uACE0 \uD588\uC2B5\uB2C8\uAE4C?"
  - speaker: 1
    customSpeakerName: 
    text: "\uC0B4\uB824\uB2EC\uB77C\uACE0 \uBE4C\uB354\uAD70."
  - speaker: 1
    customSpeakerName: 
    text: "\uB2E8\uCE7C\uC5D0 \uD3B8\uD788 \uBCF4\uB0B4\uC92C\uB2E4."
  - speaker: 0
    customSpeakerName: 
    text: "\uD558\uD558\uD558 \uBB34\uC790\uBE44\uD558\uC2DC\uAD70\uC694..."
  - speaker: 3
    customSpeakerName: 
    text: "\uC774\uC81C \uBB58 \uD558\uBA74 \uB420\uAE4C\uC694?"
  - speaker: 0
    customSpeakerName: 
    text: "\uC7A0\uC2DC \uC7AC\uC815\uBE44\uC758 \uC2DC\uAC04\uC744 \uAC00\uC9C0\uC2DC\uBA74
      \uB420 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    customSpeakerName: 
    text: "\uC544\uC9C1 \uB4DC\uC6CC\uD504 \uC2E0\uC804\uC73C\uB85C \uAC00\uB294
      \uAE38\uC774 \uB9C9\uD600 \uC788\uC2B5\uB2C8\uB2E4."
  - speaker: 3
    customSpeakerName: 
    text: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    customSpeakerName: 
    text: "\uC138\uACC4\uC218\uC758 \uC601\uAD11\uC744 \uB418\uCC3E\uAE30 \uC704\uD574
      \uD798\uC368\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4."
  - speaker: 0
    customSpeakerName: 
    text: "\uC2E0\uB4E4\uAED8\uC11C\uB3C4 \uAE30\uBED0\uD560 \uAC83\uC785\uB2C8\uB2E4."
  - speaker: 1
    customSpeakerName: 
    text: "\uADF8\uB798 \uC6B0\uB9B0 \uC26C\uB2E4 \uC624\uC9C0."
  - speaker: 0
    customSpeakerName: 
    text: "\uB124 \uB4DC\uC6CC\uD504 \uC2E0\uC804\uC73C\uB85C \uD5A5\uD558\uB294
      \uAE38\uC774 \uC5F4\uB9AC\uBA74 \uB9D0\uC500\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    customSpeakerName: 
    text: "(\uC774\uB7F0 \uC774\uB7F0 \uC6B0\uB9E4\uD55C \uC790\uB4E4\uC774 \uC9C4\uC2E4\uC5D0
      \uB2FF\uC544\uC11C\uB294 \uC548 \uB418\uC8E0.)"
  - speaker: 0
    customSpeakerName: 
    text: "(\uB2F9\uC2E0\uB4E4\uC740 \uADF8\uC800 \uC2E0\uB4E4\uC758 \uAC70\uB984\uC77C
      \uBFD0\uC785\uB2C8\uB2E4.)"
  - speaker: 0
    customSpeakerName: 
    text: "(\uC2E0\uB4E4\uC758 \uC2DC\uB300\uB97C \uB418\uCC3E\uACE0 \uC138\uACC4\uC218\uAC00
      \uC601\uAD11\uC744 \uB418\uCC3E\uAE38...)"
  notReadyDialogueLines: []
  futureQuestDialogueLines: []
  completedDialogueLines:
  - speaker: 0
    customSpeakerName: 
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4 \uC601\uC6C5\uB2D8."
  shopData: {fileID: 0}
  interactRange: 2
  promptObject: {fileID: 1730323128}
