  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 23a6d0d6f97a13b40895c95e19a1e392, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\uC804\uD22C\uC758 \uC0AC\uC81C"
  npcId: NPC_TutorialCombat
  npcType: 2
  dialogueLines:
  - speaker: 0
    text: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C \uC800\uB294 \uC804\uD22C\uC758 \uC0AC\uC81C\uC785\uB2C8\uB2E4.
      \uC804\uD22C\uC758 \uAE30\uBCF8\uC744 \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC774\uB3D9\uC740 \uC544\uC2DC\uB2E4\uC2DC\uD53C \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD
      \uD074\uB9AD\uC785\uB2C8\uB2E4."
  - speaker: 0
    text: "\uACF5\uACA9\uC740 \uC801\uC5D0\uAC8C \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD
      \uD074\uB9AD\uC744 \uD558\uBA74 \uD30C\uD2F0\uC6D0 \uBAA8\uB450\uAC00 \uD574\uB2F9
      \uC801\uC744 \uACF5\uACA9\uD569\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC2A4\uD398\uC774\uC2A4\uBC14\uB294 \uD30C\uD2F0\uC6D0 \uACE0\uC815 \uD0A4
      \uC785\uB2C8\uB2E4. \uD30C\uD2F0\uC6D0\uC740 \uC0AC\uAC70\uB9AC \uC548\uC5D0\uC11C
      \uACF5\uACA9\uB9CC \uD558\uACE0 \uB9AC\uB354\uAC00 \uC774\uB3D9\uD574\uB3C4
      \uC774\uB3D9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uBCF4\uC2A4 \uC804\uD22C\uC5D0\uC11C
      \uC798 \uC0AC\uC6A9\uD558\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4."
  - speaker: 0
    text: "\uD3EC\uC158\uC740 S, D \uD0A4\uC774\uBA70 \uBAA8\uB4E0 \uD30C\uD2F0\uC6D0\uC758
      \uCCB4\uB825, \uB9C8\uB098\uAC00 \uD68C\uBCF5\uB429\uB2C8\uB2E4."
  notReadyDialogueLines: []
  shopData: {fileID: 0}
  interactRange: 2
  promptObject: {fileID: 1001109153}
