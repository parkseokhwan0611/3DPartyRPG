--- !u!114 &197429989
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 197429985}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 23a6d0d6f97a13b40895c95e19a1e392, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\uBB34\uAD6C\uC758 \uC0AC\uC81C"
  npcId: NPC_TutorialItem
  npcType: 2
  dialogueLines:
  - speaker: 0
    text: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C \uC800\uB294 \uBB34\uAD6C\uC758 \uC0AC\uC81C\uC785\uB2C8\uB2E4.
      \uC544\uC774\uD15C\uC758 \uAE30\uBCF8\uC744 \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uB9C8\uBB3C\uC744 \uCC98\uCE58\uD558\uAC70\uB098 \uC0C1\uC810\uC5D0\uC11C
      \uAD6C\uB9E4, \uD018\uC2A4\uD2B8 \uD074\uB9AC\uC5B4 \uB4F1\uC73C\uB85C \uC544\uC774\uD15C\uC744
      \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC544\uC774\uD15C\uC740 \uBB34\uAE30, \uBC29\uC5B4\uAD6C, \uC7A5\uC2E0\uAD6C,
      \uD3EC\uC158, \uAC15\uD654 \uC8FC\uBB38\uC11C, \uC7AC\uB8CC \uC544\uC774\uD15C\uC73C\uB85C
      \uB098\uB269\uB2C8\uB2E4."
  - speaker: 0
    text: "\uBB34\uAE30\uC640 \uBC29\uC5B4\uAD6C\uB294 \uBB34\uAE30 \uAC15\uD654
      \uC8FC\uBB38\uC11C, \uBC29\uC5B4\uAD6C \uAC15\uD654 \uC8FC\uBB38\uC11C\uB85C
      \uAC15\uD654\uAC00 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC7A5\uC2E0\uAD6C\uB294 \uAC15\uD654\uAC00 \uBD88\uAC00\uB2A5\uD558\uC9C0\uB9CC
      \uD2B9\uBCC4\uD55C \uC635\uC158\uC744 \uAC16\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - speaker: 0
    text: "\uC544\uC774\uD15C\uC5D0\uB294 \uC77C\uBC18, \uACE0\uAE09, \uC601\uC6C5,
      \uC804\uC124, \uC2E0\uD654 5\uAC00\uC9C0 \uB4F1\uAE09\uC774 \uC874\uC7AC\uD569\uB2C8\uB2E4."
  - speaker: 0
    text: "\uAC15\uD654 \uC8FC\uBB38\uC11C\uB294 \uC8FC\uBB38\uC11C\uC758 \uB4F1\uAE09\uACFC
      \uB3D9\uC77C\uD55C \uC544\uC774\uD15C\uB9CC \uAC15\uD654 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  notReadyDialogueLines: []
  shopData: {fileID: 0}
  interactRange: 2
  promptObject: {fileID: 686127407}
